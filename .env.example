APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Branding / BoT digital lending LNO
# BRAND_LEGAL_NAME="Kopafasta Microfinance Ltd"
# BRAND_SMS_SENDER_ID=KOPAFASTA
# Licensed Tier 2 entity: Tanzania residents + TZS only (set false to re-open other markets)
DIGITAL_LENDING_TZ_ONLY=true
COUNTRY_CURRENCY=TZS

# Web/API two-factor enforcement (admin, staff, partner portals)
REQUIRE_2FA_ADMIN=false
REQUIRE_2FA_STAFF=false
REQUIRE_2FA_PARTNER=false
# TWO_FACTOR_SESSION_HOURS=12

# Tanzania Credit Bureau (D&B Live Request — see crb/ folder)
CRB_DRIVER=stub
# Live SOAP: https://cweb.dnbtanzania.com/TanWebsite/Services/LiveRequestService.svc
CRB_ENDPOINT=
CRB_EMAIL=
CRB_PASSWORD=
CRB_CONSUMER_REPORT_ID=14616
CRB_CONSUMER_SUBJECT_TYPE=1
CRB_PURPOSE_OF_INQUIRY=1
CRB_TIMEOUT=30
CRB_AUTO_SELECT_MIN_SCORE=95

# PayIn mobile money (docs.payin.co.tz) — prefer Admin → Settings → Integrations → PayIn
PAYIN_ENABLED=false
PAYIN_ENVIRONMENT=sandbox
PAYIN_API_KEY=
PAYIN_API_SECRET=
PAYIN_WEBHOOK_SECRET=
PAYIN_CALLBACK_URL=

# --- Environment isolation (local / staging / production) ---
# Staging: APP_ENV=staging, SEO_ALLOW_INDEXING=false, PAYIN_ENVIRONMENT=sandbox
# Production: APP_ENV=production, SEO_ALLOW_INDEXING=true, PAYIN_ENVIRONMENT=live
SEO_ALLOW_INDEXING=false
SESSION_COOKIE=kopafasta-local-session
CACHE_PREFIX=kopafasta-local-
# SESSION_DOMAIN=null keeps cookies host-only (staging must not authenticate production)
# RELEASE_VERSION=dev
# RELEASE_COMMIT=
# APP_SHOW_ENV_BANNER=false

