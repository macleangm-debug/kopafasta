# Staging Droplet — Nginx (placeholders only; do not apply until the Droplet IP exists)
#
# server_name staging.kopafasta.com
# root /var/www/kopafasta/public
# HTTP → HTTPS, Let's Encrypt
# X-Robots-Tag noindex
# Optional HTTP basic auth so ordinary visitors do not land here.

server {
    listen 80;
    listen [::]:80;
    server_name staging.kopafasta.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name staging.kopafasta.com;

    root /var/www/kopafasta/public;
    index index.php;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 25M;
    charset utf-8;

    # Uncomment after: htpasswd -c /etc/nginx/.htpasswd-staging <user>
    # auth_basic "Kopafasta staging";
    # auth_basic_user_file /etc/nginx/.htpasswd-staging;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    # Branded static fallback for upstream failures (PHP-FPM down/timeout).
    # Keep genuine 5xx status — do not mask as 200.
    error_page 502 503 504 /errors/50x.html;
    location = /errors/50x.html {
        root /var/www/kopafasta/public;
        internal;
    }

    error_page 404 /index.php;

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_read_timeout 120s;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
