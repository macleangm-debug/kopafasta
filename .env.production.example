# Copy onto the production Droplet as /var/www/kopafasta/.env
# Never reuse staging credentials. Never set APP_DEBUG=true.

APP_NAME=Kopafasta
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.kopafasta.co.tz
APP_SHOW_ENV_BANNER=false
SEO_ALLOW_INDEXING=true

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kopafasta_production
DB_USERNAME=kopafasta_production
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_DOMAIN=null
SESSION_COOKIE=kopafasta-session
CACHE_STORE=database
CACHE_PREFIX=kopafasta-production-
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_FROM_ADDRESS="hello@kopafasta.com"
MAIL_FROM_NAME="${APP_NAME}"

PAYIN_ENABLED=true
PAYIN_ENVIRONMENT=live
PAYIN_CALLBACK_URL=https://www.kopafasta.co.tz/webhooks/payin

RELEASE_VERSION=v1.0.0
