# Copy onto the staging Droplet as /var/www/kopafasta/.env
# Never copy production secrets into this file.

APP_NAME=Kopafasta
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.kopafasta.com
APP_SHOW_ENV_BANNER=true
SEO_ALLOW_INDEXING=false

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kopafasta_staging
DB_USERNAME=kopafasta_staging
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_DOMAIN=null
SESSION_COOKIE=kopafasta-staging-session
CACHE_STORE=database
CACHE_PREFIX=kopafasta-staging-
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="staging@kopafasta.com"
MAIL_FROM_NAME="${APP_NAME} staging"

PAYIN_ENABLED=false
PAYIN_ENVIRONMENT=sandbox
PAYIN_CALLBACK_URL=https://staging.kopafasta.com/webhooks/payin

RELEASE_VERSION=dev
